 </head>
 
+<script>
+(function () {
+  var BASE = "/stoat";
+  function fix(url) {
+    if (typeof url !== "string" || url.charAt(0) !== "/") return url;
+    if (url === BASE || url.indexOf(BASE + "/") === 0 || url.indexOf(BASE + "?") === 0) return url;
+    return BASE + url;
+  }
+  var push = history.pushState;
+  history.pushState = function (state, title, url) { return push.call(this, state, title, fix(url)); };
+  var replace = history.replaceState;
+  history.replaceState = function (state, title, url) { return replace.call(this, state, title, fix(url)); };
+  document.addEventListener("click", function (event) {
+    if (event.defaultPrevented || event.button !== 0) return;
+    var anchor = event.target && event.target.closest && event.target.closest("a");
+    if (!anchor || anchor.classList.contains("nullcord-return")) return;
+    var href = anchor.getAttribute("href");
+    if (!href || href.charAt(0) !== "/" || href === BASE || href.indexOf(BASE + "/") === 0 || href.indexOf(BASE + "?") === 0) return;
+    event.preventDefault();
+    var target = BASE + href;
+    if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
+      window.open(target, anchor.getAttribute("target") || "_blank");
+    } else {
+      window.location.href = target;
+    }
+  }, true);
+})();
+</script>
