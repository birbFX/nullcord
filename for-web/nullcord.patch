+    var anchor = event.target && event.target.closest && event.target.closest("a");
+    if (!anchor || anchor.classList.contains("nullcord-return")) return;
+    var href = anchor.getAttribute("href");
+    if (!href || href.charAt(0) !== "/" || href === BASE || href.indexOf(BASE + "/") === 0 || href.indexOf(BASE + "?") === 0) return;
+    event.preventDefault();
+    var target = BASE + href;
+    if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
+      window.open(target, anchor.getAttribute("target") || "_blank");
+    } else {
+      window.location.href = target;
+    }
+  }, true);
