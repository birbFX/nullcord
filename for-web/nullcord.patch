@@ -0,0 +1,364 @@
+import { For, Show, createSignal, onCleanup, onMount } from "solid-js";
+import { useClient, useUser } from "@revolt/client";
+import { useNavigate } from "@revolt/routing";
+import { useState } from "@revolt/state";
+
+import questData from "./nullcord/quests.json";
+
+type Quest = {
+  id: string;
+  title: string;
+  description: string;
+  reward: number;
+  verification: string;
+  target?: number;
+};
+
+type Tab = "quests" | "nitro" | "tags" | "plugins" | "dev";
+
+const OWNER_ID = "01M5KCFRPDZZHPADH5BKJT19VG";
+const CLL_SERVER_ID = "01M5KCHRW16JAS02MQN2SWRNX8";
+const PLUGINS = [
+  { id: "server-tags", name: "Server Tags", description: "Show equipped server tags." },
+  { id: "quest-helper", name: "Quest Helper", description: "Show daily quest progress." },
+  { id: "no-snow", name: "No Snow", description: "Disable seasonal snow." },
+];
+
+function today() {
+  return new Date().toISOString().slice(0, 10);
+}
+
+function hash(input: string) {
+  let h = 2166136261;
+  for (let i = 0; i < input.length; i++) {
+    h ^= input.charCodeAt(i);
+    h = Math.imul(h, 16777619);
+  }
+  return h >>> 0;
+}
+
+function dailyQuests(userId?: string): Quest[] {
+  const seed = `${today()}:${userId ?? "guest"}`;
+  return [...(questData as Quest[])]
+    .sort((a, b) => hash(seed + a.id) - hash(seed + b.id))
+    .slice(0, 6);
+}
+
+function readJson<T>(key: string, fallback: T): T {
+  try {
+    return JSON.parse(localStorage.getItem(key) ?? "") as T;
+  } catch {
+    return fallback;
+  }
+}
+
+function getOrbs(userId?: string) {
+  if (!userId) return 0;
+  return parseInt(localStorage.getItem(`nullcord:orbs:${userId}`) ?? "0", 10) || 0;
+}
+
+function setOrbs(userId: string, value: number) {
+  localStorage.setItem(`nullcord:orbs:${userId}`, String(Math.max(0, value)));
+}
+
+function stats(userId?: string): Record<string, number> {
+  if (!userId) return {};
+  return readJson(`nullcord:quest-events:${userId}:${today()}`, {});
+}
+
+function done(userId: string | undefined, quest: Quest) {
+  if (!userId) return false;
+  const claims = readJson<Record<string, string>>(`nullcord:quests:${userId}`, {});
+  return claims[quest.id] === today();
+}
+
+function progress(userId: string | undefined, quest: Quest) {
+  const target = quest.target ?? 1;
+  const current = Math.min(stats(userId)[quest.verification] ?? 0, target);
+  return { current, target, verified: current >= target };
+}
+
+function claim(userId: string | undefined, quest: Quest) {
+  if (!userId || done(userId, quest) || !progress(userId, quest).verified) return false;
+  const claims = readJson<Record<string, string>>(`nullcord:quests:${userId}`, {});
+  claims[quest.id] = today();
+  localStorage.setItem(`nullcord:quests:${userId}`, JSON.stringify(claims));
+  setOrbs(userId, getOrbs(userId) + quest.reward);
+  return true;
+}
+
+function nitroTier(user: { id?: string; privileged?: boolean } | undefined) {
+  if (!user?.id) return null;
+  if (user.privileged || user.id === OWNER_ID) return "nitro";
+  const value = localStorage.getItem(`nullcord:nitro:${user.id}`);
+  if (value === "basic" || value === "nitro" || value === "1") {
+    return value === "basic" ? "basic" : "nitro";
+  }
+  return null;
+}
+
+function serverTag(serverId: string) {
+  const data = readJson<{ tag?: string }>(`nullcord:server:${serverId}`, {});
+  return data.tag || (serverId === CLL_SERVER_ID ? "CLL" : "");
+}
+
+function isDev(user: { id?: string; privileged?: boolean; badges?: number } | undefined) {
+  return (
+    !!user &&
+    (user.id === OWNER_ID ||
+      !!user.privileged ||
+      (typeof user.badges === "number" && (user.badges & 1) !== 0))
+  );
+}
+
+export function NullCordTracker() {
+  const client = useClient();
+  const user = useUser();
+
+  onMount(() => {
+    const c = client();
+    if (!c) return;
+    const uid = user()?.id;
+
+    const onMessage = (message: any) => {
+      if (!uid || message?.authorId !== uid) return;
+      const key = `nullcord:quest-events:${uid}:${today()}`;
+      const data = readJson<Record<string, number>>(key, {});
+      data.message_sent = (data.message_sent ?? 0) + 1;
+      if (message.attachments?.length) data.image_sent = (data.image_sent ?? 0) + 1;
+      const serverId = message.server?.id;
+      if (serverId) {
+        const spoken = readJson<string[]>(`nullcord:spoken-servers:${uid}`, []);
+        if (!spoken.includes(serverId)) {
+          spoken.push(serverId);
+          localStorage.setItem(`nullcord:spoken-servers:${uid}`, JSON.stringify(spoken));
+          data.first_message_server = (data.first_message_server ?? 0) + 1;
+        }
+      }
+      localStorage.setItem(key, JSON.stringify(data));
+    };
+
+    const onReaction = (_message: any, userId: string) => {
+      if (!uid || userId !== uid) return;
+      const key = `nullcord:quest-events:${uid}:${today()}`;
+      const data = readJson<Record<string, number>>(key, {});
+      data.reaction = (data.reaction ?? 0) + 1;
+      localStorage.setItem(key, JSON.stringify(data));
+    };
+
+    const onMemberJoin = (member: any) => {
+      if (!uid) return;
+      const serverId = member?.id?.server;
+      if (!serverId) return;
+      const pending = readJson<{ serverId: string; code: string; ts: number }[]>(
+        `nullcord:pending-invites:${uid}`,
+        [],
+      );
+      const match = pending.find((invite) => invite.serverId === serverId);
+      if (!match) return;
+      const key = `nullcord:quest-events:${uid}:${today()}`;
+      const data = readJson<Record<string, number>>(key, {});
+      data.invite_joined = (data.invite_joined ?? 0) + 1;
+      if (serverId === CLL_SERVER_ID) {
+        data.invite_joined_cll = (data.invite_joined_cll ?? 0) + 1;
+      }
+      localStorage.setItem(key, JSON.stringify(data));
+      localStorage.setItem(
+        `nullcord:pending-invites:${uid}`,
+        JSON.stringify(pending.filter((invite) => invite !== match)),
+      );
+    };
+
+    c.on("messageCreate", onMessage);
+    c.on("messageReactionAdd", onReaction);
+    c.on("serverMemberJoin", onMemberJoin);
+    onCleanup(() => {
+      c.off?.("messageCreate", onMessage);
+      c.off?.("messageReactionAdd", onReaction);
+      c.off?.("serverMemberJoin", onMemberJoin);
+    });
+  });
+
+  return null;
+}
+
+export function NullCordPage() {
+  const client = useClient();
+  const user = useUser();
+  const navigate = useNavigate();
+  const state = useState();
+  const [tab, setTab] = createSignal<Tab>("quests");
+  const [tick, setTick] = createSignal(0);
+  const refresh = () => setTick((v) => v + 1);
+
+  const userId = () => user()?.id;
+  const admin = () => !!user()?.privileged || user()?.id === OWNER_ID;
+
+  const switchUi = (mode: "regular" | "combined") => {
+    const session = state.auth.getSession();
+    if (session) {
+      localStorage.setItem(
+        "nullcord:handoff",
+        JSON.stringify({
+          token: session.token,
+          userId: session.userId,
+          sessionId: session._id,
+          expires: Date.now() + 120000,
+          target: "nullcord",
+        }),
+      );
+    }
+    document.cookie = "nullcord_client=nullcord; path=/; SameSite=Lax";
+    localStorage.setItem("nullcord:ui-mode", mode);
+    location.href = "/";
+  };
+
+  const buyNitro = (tier: "basic" | "nitro") => {
+    const id = userId();
+    if (!id) return;
+    const current = nitroTier(user());
+    if (tier === "basic" && current) return;
+    if (tier === "nitro" && current === "nitro") return;
+    const cost = tier === "basic" ? 300 : current === "basic" ? 600 : 900;
+    if (!admin() && getOrbs(id) < cost) return;
+    if (!admin()) setOrbs(id, getOrbs(id) - cost);
+    localStorage.setItem(`nullcord:nitro:${id}`, tier);
+    refresh();
+  };
+
+  const equipTag = (serverId: string) => {
+    const id = userId();
+    if (!id || !serverTag(serverId)) return;
+    localStorage.setItem(`nullcord:equipped-tag:${id}`, serverId);
+    refresh();
+  };
+
+  const togglePlugin = (id: string) => {
+    const data = readJson<Record<string, boolean>>("nullcord:plugins", {});
+    data[id] = !(data[id] ?? true);
+    localStorage.setItem("nullcord:plugins", JSON.stringify(data));
+    refresh();
+  };
+
+  const panel = { padding: 18, borderRadius: 18, minWidth: 0, overflow: "hidden", background: "var(--md-sys-color-surface-container)", border: "1px solid var(--md-sys-color-outline-variant)", overflowWrap: "anywhere" } as const;
+  const btn = { border: 0, borderRadius: 999, padding: "9px 14px", fontWeight: 700, cursor: "pointer", background: "var(--md-sys-color-primary)", color: "var(--md-sys-color-on-primary)" } as const;
+
+  const orbLabel = () => {
+    if (admin()) return "∞ Orbs";
+    const value = getOrbs(userId());
+    return value > 999999 ? "∞ Orbs" : `${value.toLocaleString()} Orbs`;
+  };
+
+  return (
+    <div style={{ boxSizing: "border-box", height: "100%", width: "100%", overflowY: "auto", padding: "28px 34px", color: "var(--md-sys-color-on-surface)", background: "var(--md-sys-color-surface)" }}>
+      <div style={{ "max-width": "980px", width: "100%", margin: "0 auto" }}>
+        <div style={{ display: "flex", "align-items": "center", gap: 16, "margin-bottom": 18, "flex-wrap": "wrap" }}>
+          <h1 style={{ margin: 0, "font-size": 32 }}>NullCord</h1>
+          <span style={{ opacity: 0.65 }}>{orbLabel()}</span>
+        </div>
+
+        <div style={{ display: "flex", gap: 8, "flex-wrap": "wrap", "margin-bottom": 20 }}>
+          <For each={["quests", "nitro", "tags", "plugins", ...(isDev(user()) ? ["dev"] : [])] as Tab[]}>
+            {(id) => (
+              <button onClick={() => setTab(id)} style={{ ...btn, background: tab() === id ? "var(--md-sys-color-primary)" : "var(--md-sys-color-surface-container-high)", color: tab() === id ? "var(--md-sys-color-on-primary)" : "var(--md-sys-color-on-surface)" }}>
+                {id === "dev" ? "Dev" : id[0].toUpperCase() + id.slice(1)}
+              </button>
+            )}
+          </For>
+        </div>
+
+        <Show when={tab() === "quests"}>
+          <div style={{ display: "grid", "grid-template-columns": "repeat(auto-fill, minmax(min(280px, 100%), 1fr))", gap: 12 }}>
+            <For each={dailyQuests(userId())}>
+              {(quest) => {
+                tick();
+                const p = progress(userId(), quest);
+                const claimed = done(userId(), quest);
+                return (
+                  <div style={{ ...panel, opacity: p.verified || claimed ? 1 : 0.6 }}>
+                    <div style={{ "font-weight": 800, "font-size": 16 }}>{quest.title}</div>
+                    <p style={{ opacity: 0.72, "font-size": 13, "line-height": 1.5 }}>{quest.description}</p>
+                    <div style={{ display: "flex", "justify-content": "space-between", "align-items": "center" }}>
+                      <span style={{ color: "var(--md-sys-color-primary)" }}>+{quest.reward} Orbs</span>
+                      <span style={{ "font-size": 11, opacity: 0.65 }}>{claimed ? "✓ Claimed" : p.verified ? "✓ Verified" : `${p.current}/${p.target}`}</span>
+                    </div>
+                    <button disabled={claimed || !p.verified} onClick={() => { if (claim(userId(), quest)) refresh(); }} style={{ ...btn, marginTop: 12, opacity: claimed || !p.verified ? 0.5 : 1 }}>
+                      {claimed ? "Claimed today" : p.verified ? "Claim" : "Verify first"}
+                    </button>
+                  </div>
+                );
+              }}
+            </For>
+          </div>
+        </Show>
+
+        <Show when={tab() === "nitro"}>
+          <div style={{ display: "grid", "grid-template-columns": "repeat(auto-fit, minmax(280px, 1fr))", gap: 14 }}>
+            <div style={panel}>
+              <h2 style={{ margin: "0 0 6px" }}>Nitro Basic</h2>
+              <p style={{ opacity: 0.72 }}>300 Orbs · basic badge and perks. No boosts or custom themes.</p>
+              <button disabled={!!nitroTier(user())} onClick={() => buyNitro("basic")} style={btn}>{nitroTier(user()) === "basic" ? "Active" : nitroTier(user()) === "nitro" ? "Included in Nitro" : "Redeem · 300 Orbs"}</button>
+            </div>
+            <div style={{ ...panel, borderColor: "var(--md-sys-color-primary)" }}>
+              <h2 style={{ margin: "0 0 6px" }}>Nitro</h2>
+              <p style={{ opacity: 0.72 }}>900 Orbs · 2 boosts, full themes and gradients.</p>
+              <button disabled={nitroTier(user()) === "nitro"} onClick={() => buyNitro("nitro")} style={btn}>{nitroTier(user()) === "nitro" ? "Active" : nitroTier(user()) === "basic" ? "Upgrade · 600 Orbs" : "Redeem · 900 Orbs"}</button>
+            </div>
+          </div>
+          <p style={{ opacity: 0.65, "font-size": 12, "margin-top": 14 }}>Same Orbs and tier as the NullCord client; changes sync through this browser.</p>
+        </Show>
+
+        <Show when={tab() === "tags"}>
+          <For each={client()?.servers.toList() ?? []}>
+            {(server: any) => {
+              tick();
+              const tag = serverTag(server.id);
+              const equipped = localStorage.getItem(`nullcord:equipped-tag:${userId()}`) === server.id;
+              return (
+                <div style={{ ...panel, display: "flex", "align-items": "center", gap: 12, "margin-bottom": 8, opacity: tag ? 1 : 0.5 }}>
+                  <div style={{ flex: 1 }}><b>{server.name}</b><div style={{ "font-size": 11, opacity: 0.65 }}>{tag ? `◆ ${tag}` : "No tag set"}</div></div>
+                  <button disabled={!tag || equipped} onClick={() => equipTag(server.id)} style={{ ...btn, opacity: !tag || equipped ? 0.5 : 1 }}>{equipped ? "Equipped" : "Equip"}</button>
+                </div>
+              );
+            }}
+          </For>
+        </Show>
+
+        <Show when={tab() === "plugins"}>
+          <For each={PLUGINS}>
+            {(plugin) => {
+              tick();
+              const states = readJson<Record<string, boolean>>("nullcord:plugins", {});
+              const enabled = states[plugin.id] ?? true;
+              return (
+                <div style={{ ...panel, display: "flex", "align-items": "center", gap: 12, "margin-bottom": 8 }}>
+                  <div style={{ flex: 1 }}><b>{plugin.name}</b><div style={{ "font-size": 12, opacity: 0.65 }}>{plugin.description}</div></div>
+                  <button onClick={() => togglePlugin(plugin.id)} style={{ ...btn, background: enabled ? "var(--md-sys-color-primary)" : "var(--md-sys-color-surface-container-high)", color: enabled ? "var(--md-sys-color-on-primary)" : "var(--md-sys-color-on-surface)" }}>{enabled ? "Enabled" : "Disabled"}</button>
+                </div>
+              );
+            }}
+          </For>
+        </Show>
+
+        <Show when={tab() === "dev"}>
+          <div style={panel}>
+            <h2 style={{ marginTop: 0 }}>Developer</h2>
+            <p style={{ opacity: 0.7 }}>NullCord developer tools are available to owners, admins and Developer-badge holders.</p>
+            <p style={{ "font-size": 13 }}>User: {user()?.username ?? user()?.id}<br />Client: Stoat for Web / NullCord<br />API: {client()?.configuration?.api ?? "connected"}</p>
+            <button onClick={() => navigate("/dev")} style={btn}>Open client dev tools</button>
+          </div>
+        </Show>
+
+        <div style={{ ...panel, "margin-top": 20 }}>
+          <b>UI</b>
+          <p style={{ opacity: 0.65, "font-size": 12 }}>Switch clients with automatic handoff.</p>
+          <div style={{ display: "flex", gap: 8, "flex-wrap": "wrap" }}>
+            <button onClick={() => switchUi("regular")} style={btn}>Regular</button>
+            <button onClick={() => switchUi("combined")} style={btn}>Combined</button>
+            <button onClick={() => {}} style={{ ...btn, opacity: 0.6 }}>Full NullCord UI</button>
+          </div>
+        </div>
+      </div>
+    </div>
+  );
+}
